# Environment Variables for CampusTix

# Database Configuration (PostgreSQL with Prisma)
# In local development or production, provide your PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:password@localhost:5432/campustix?schema=public"

# Node.js Server Port
PORT=3000

# Authentication & Security
JWT_SECRET="campustix_super_secure_jwt_secret_key_2026"
SESSION_SECRET="campustix_session_secret_key"

# Hold Expiration Setting (in minutes)
RESERVATION_HOLD_MINUTES=10

# AI Studio App Hosting URL
APP_URL="MY_APP_URL"
